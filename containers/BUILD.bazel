load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# All binaries from //cmd/...
BINARIES = [
    "//cmd/cacheserver",
    "//cmd/dirserver",
    "//cmd/frontend",
    "//cmd/keyserver",
    "//cmd/local_keyserver",
    "//cmd/storeserver",
    "//cmd/upbox",
    "//cmd/upspin",
    "//cmd/upspin-audit",
    "//cmd/upspin-setupstorage",
    "//cmd/upspinfs",
    "//cmd/upspinserver",
]

pkg_tar(
    name = "binaries_tar",
    srcs = BINARIES,
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "image",
    base = "@distroless_static",
    tars = [":binaries_tar"],
)

oci_image_index(
    name = "image_index",
    images = [
        ":image",
    ],
    platforms = [
        "@rules_go//go/toolchain:linux_amd64",
        "@rules_go//go/toolchain:linux_arm64",
    ],
)

# Remote tags for :push, derived from the release tag.
#
#   bazel run //containers:push --embed_label=v43.0.3
#
# publishes exactly one tag, `43.0.3`. The leading `v` of the git tag is
# stripped so the container carries a bare semver, matching the convention used
# for the binaries published alongside each release. No floating `latest` tag is
# published: every image is addressable by an explicit version, so a deployment
# that pins one always names what it actually runs.
#
# Without --embed_label the placeholder `0.0.0` is emitted rather than failing,
# so that `bazel build //...` stays green and this action stays cacheable, as
# recommended in rules_oci's oci_push docs. CI always stamps, and
# .github/workflows/publish-container.yml rejects a non-semver tag before it
# reaches this rule, so `0.0.0` can never reach the registry from a release.
genrule(
    name = "remote_tags",
    outs = ["remote_tags.txt"],
    cmd = """
version=$$(sed -n 's/^BUILD_EMBED_LABEL //p' bazel-out/stable-status.txt)
version=$${version#v}
printf '%s\\n' "$${version:-0.0.0}" > $@
""",
    stamp = 1,
)

oci_push(
    name = "push",
    image = ":image_index",
    remote_tags = ":remote_tags",
    repository = "index.docker.io/filipfilmar/upspin",
)
