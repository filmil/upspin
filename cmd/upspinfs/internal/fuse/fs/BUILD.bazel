    importpath = "upspin.io/cmd/upspinfs/internal/fuse/fs",
    visibility = ["//cmd/upspinfs:__subpackages__"],
    deps = [
        "//cmd/upspinfs/internal/fuse",
        "//cmd/upspinfs/internal/fuse/fuseutil",
