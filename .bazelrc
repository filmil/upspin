build --registry=https://raw.githubusercontent.com/filmil/bazel-registry/main --registry=https://bcr.bazel.build
# Release builds: --config=release stamps the commit and the release tag
# into -version (version/BUILD.bazel). Other builds do not run the status
# command and print "devel".
build:release --stamp
# A release must not write to the tree it stamps: cross-compiling would
# rewrite MODULE.bazel.lock and make the commit "-dirty".
build:release --lockfile_mode=off
build:release --workspace_status_command=tools/workspace_status.sh
