# The integration module builds and tests upspin the way an outside module
# does: as a bazel_dep, with none of the root module's dev dependencies and
# no custom registry. BCR presubmit runs it as the test module; see
# .bcr/presubmit.yml.
module(
    name = "filmil_upspin_integration",
    version = "0.0.0",
)

# repo_name keeps the labels @upspin//..., as a user of the module may.
bazel_dep(name = "filmil_upspin", version = "0.0.0", repo_name = "upspin")
local_path_override(
    module_name = "filmil_upspin",
    path = "..",
)

bazel_dep(name = "rules_go", version = "0.61.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "@upspin//:go.mod")
