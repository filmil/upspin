load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "https",
    srcs = ["https.go"],
    importpath = "upspin.io/cloud/https",
    visibility = ["//visibility:public"],
    deps = [
        "//access",
        "//errors",
        "//flags",
        "//log",
        "//serverutil",
        "//serverutil/metrics",
        "//shutdown",
        "@org_golang_x_crypto//acme/autocert",
    ],
)

go_test(
    name = "https_test",
    size = "small",
    srcs = ["https_test.go"],
    data = ["//rpc/testdata:rpc_testdata"],
    embed = [":https"],
)
